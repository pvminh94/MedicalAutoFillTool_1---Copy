@model List<FormProfile>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý Form";
}
<style>
    body { overflow: auto; padding: 20px; font-family: Arial, sans-serif; }
    h2 { margin: 0 0 20px 0; color: #1a237e; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }
    th { background: #1a237e; color: #fff; font-size: 13px; }
    td { font-size: 13px; }
    .btn { display: inline-block; padding: 6px 14px; border: none; border-radius: 4px; cursor: pointer; font-size: 12px; text-decoration: none; margin: 2px; }
    .btn-primary { background: #2196f3; color: #fff; }
    .btn-danger { background: #f44336; color: #fff; }
    .btn-success { background: #4caf50; color: #fff; }
    .btn-sm { padding: 4px 10px; font-size: 11px; }
    .badge { background: #e0e0e0; padding: 2px 8px; border-radius: 10px; font-size: 11px; }
    .new-form { border: 1px solid #ddd; padding: 15px; border-radius: 6px; margin-top: 20px; background: #f9f9f9; }
    .new-form input[type=text] { width: 100%; padding: 8px; margin: 5px 0; border: 1px solid #ccc; border-radius: 4px; }
    .close-btn { float: right; cursor: pointer; font-size: 20px; color: #666; }
</style>

<h2>⚙ Quản lý Form cấu hình</h2>
<p style="color: #666; margin-bottom: 20px;">
    Các form này sẽ tự động nhận diện khi bạn mở URL có chứa chuỗi nhận diện tương ứng.
</p>

@if (TempData["Message"] != null)
{
    <div style="background:#d4edda;padding:10px;border-radius:4px;margin-bottom:15px;">@TempData["Message"]</div>
}

<table>
    <thead>
        <tr>
            <th>Tên form</th>
            <th>Chuỗi URL nhận diện</th>
            <th>Số trường</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td><strong>@f.Name</strong></td>
                <td><code>@f.UrlContains</code></td>
                <td><span class="badge">@f.Fields.Count</span></td>
                <td>
                    <a class="btn btn-primary btn-sm" href="/Home/EditForm/@f.Id">✏ Sửa</a>
                    <form method="post" action="/Home/DeleteForm/@f.Id" style="display:inline" 
                          onsubmit="return confirm('Xóa form @f.Name?');">
                        <button type="submit" class="btn btn-danger btn-sm">🗑 Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<button class="btn btn-success" onclick="showNewForm()">+ Thêm form mới</button>
<a class="btn btn-primary" href="/" style="float:right">← Về trang chính</a>

<div id="newForm" class="new-form" style="display:none">
    <span class="close-btn" onclick="hideNewForm()">✖</span>
    <h3>Thêm form mới</h3>
    <form method="post" action="/Home/SaveForm">
        <div>
            <label>Tên form:</label>
            <input type="text" name="Name" required placeholder="VD: Phiếu Cận Lâm Sàng" />
        </div>
        <div>
            <label>Chuỗi nhận diện URL:</label>
            <input type="text" name="UrlContains" required placeholder="VD: KSKDK_Phieu_CanLamSang" />
        </div>
        <button type="submit" class="btn btn-success" style="margin-top:10px;">💾 Lưu form</button>
        <span style="color:#999;font-size:12px;margin-left:10px;">(sau khi lưu có thể thêm trường)</span>
    </form>
</div>

<script>
    function showNewForm() { document.getElementById('newForm').style.display = 'block'; }
    function hideNewForm() { document.getElementById('newForm').style.display = 'none'; }
</script>