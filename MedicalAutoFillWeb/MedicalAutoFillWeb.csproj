<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MedicalAutoFillWeb</RootNamespace>
    <AssemblyName>MedicalAutoFillWeb</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ENGINE DÙNG CHUNG: một file JS duy nhất cho cả 3 bản (WinForms / Web / Bridge).
       Phục vụ cho trình duyệt qua GET /Home/EngineJs (không cần CDN, không internet). -->
  <ItemGroup>
    <EmbeddedResource Include="..\Shared\maf-engine.js" Link="Shared\maf-engine.js">
      <LogicalName>maf-engine.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
