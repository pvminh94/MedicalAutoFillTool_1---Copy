{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "../assets/**/*",
        "outDir": "dist/assets"
      },
      {
        "include": "../templates/**/*",
        "outDir": "dist/templates"
      }
    ],
    "watchAssets": true
  }
}
